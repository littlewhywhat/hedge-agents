# Copy to .env, then run `npm run wallets` to generate missing wallets and fund them from the manager.
# Amounts are ADA unless the name says lovelace.

OPERATOR_TOKEN=change-me

# Cardano Preprod via Blockfrost. Free key: https://blockfrost.io/ (Preprod project).
BLOCKFROST_PROJECT_ID=
BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0

# AI. Without a key every decision uses the rule fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Money the manager allocates across agents, on top of what agents already hold.
FUND_ADA=200
# Every wallet keeps this much for fees. Agents deposit everything above it.
WALLET_RESERVE_ADA=10
# Broker float that pays out simulated profits.
BROKER_HOUSE_ADA=100
CYCLE_MINUTES=10
DECIDE_SECONDS=20

# One 24-word mnemonic and Preprod address per wallet. Only the manager needs tADA from the faucet.
MNEMONIC_MANAGER=
CARDANO_ADDRESS_MANAGER=
MNEMONIC_BTC=
CARDANO_ADDRESS_BTC=
MNEMONIC_ETH=
CARDANO_ADDRESS_ETH=
MNEMONIC_SPX=
CARDANO_ADDRESS_SPX=
MNEMONIC_GOLD=
CARDANO_ADDRESS_GOLD=
MNEMONIC_BROKER=
CARDANO_ADDRESS_BROKER=
