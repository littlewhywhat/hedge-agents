# Copy to .env before `docker compose up`.
# Amounts are 6-decimal integers of the budget token. 1000000 = 1 tUSDM.

OPERATOR_TOKEN=change-me
DEMO_SEED=true
MASUMI_MODE=local

# Masumi payment service Preprod tUSDM (policy id + asset name, no dot).
# Mainnet budget would be USDCx. This POC refuses any environment but preprod.
BUDGET_UNIT=16a55b2a349361ff88c03788f93e1e966e5d689605d044fef722ddde0014df10745553444d

# Flat fee for a report, in the same token. Never put the budget in this price.
REPORT_FEE=1000000

# --- Chain sends. Leave blank to run the allocation locally. ---
# Free key: https://blockfrost.io/ (Preprod project).
BLOCKFROST_PROJECT_ID=
BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0

# One 24-word mnemonic per agent. The facilitator signs x402 from these.
# The manager mnemonic pays the other two. Each market mnemonic pays the manager
# or the other market when its share falls.
MNEMONIC_MANAGER=
MNEMONIC_CRYPTO=
MNEMONIC_STOCKS=

# Bech32 Preprod addresses for those mnemonics (addr_test1...).
CARDANO_ADDRESS_MANAGER=
CARDANO_ADDRESS_CRYPTO=
CARDANO_ADDRESS_STOCKS=

# --- Report fees through the payment service. Only for MASUMI_MODE=live. ---
PAYMENT_SERVICE_URL=http://payment:3001
PAYMENT_API_KEY=
AGENT_IDENTIFIER_CRYPTO=
AGENT_IDENTIFIER_STOCKS=
SELLER_VKEY_CRYPTO=
SELLER_VKEY_STOCKS=

# Payment service process (compose profile `masumi`). At least 32 characters.
ENCRYPTION_KEY=
ADMIN_KEY=
BLOCKFROST_API_KEY_PREPROD=
