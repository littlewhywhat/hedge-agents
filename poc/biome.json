{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "web/**",
      "scripts/**",
      "!**/node_modules",
      "!**/.next",
      "!dist"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "plugins": [
    "./no-function.grit",
    "./no-function-typed.grit"
  ]
}
